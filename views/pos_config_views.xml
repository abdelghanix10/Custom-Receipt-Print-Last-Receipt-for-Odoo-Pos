<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Inherits `pos.config` form view to add the new fields for the configuration for custom receipt design -->
    <record id="pos_config_view_form" model="ir.ui.view">
        <field name="name">pos.config.view.form.inherit.custom.receipts.for.pos</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting title="Custom Order Receipts" string="Custom Order Receipts" help="Use custom receipt designs for orders.">
                    <field name="is_custom_receipt"/>
                    <div class="content-group mt16">
                        <div class="row mt16">
                            <label string="Print Method" for="receipt_print_method" class="col-lg-4 o_light_label"/>
                            <field name="receipt_print_method" style="width: 66.666666%;"/>
                        </div>
                        <div class="row mt16" invisible="not is_custom_receipt">
                            <label class="col-lg-4 o_light_label"
                                   for="receipt_design_id"/>
                            <field name="receipt_design_id"
                                   required="is_custom_receipt"/>
                        </div>
                    </div>
                </setting>
                <setting title="Print Last Receipt" string="Print Last Receipt" help="Enable a button to print the last paid order.">
                    <field name="enable_print_last_receipt"/>
                    <div class="content-group mt16" invisible="not enable_print_last_receipt">
                        <div class="row mt16">
                            <label string="Print Method" for="last_receipt_print_method" class="col-lg-4 o_light_label"/>
                            <field name="last_receipt_print_method" style="width: 66.666666%;"/>
                        </div>
                        <div class="row mt16 flex">
                            <label string="Use Custom Design" for="is_print_last_receipt" class="col-lg-4 o_light_label"/>
                            <field name="is_print_last_receipt" style="width: 66.666666%;"/>
                        </div>
                        <div class="row mt16" invisible="not is_print_last_receipt">
                            <label class="col-lg-4 o_light_label"
                                   for="last_receipt_design_id"/>
                            <field name="last_receipt_design_id"
                                   required="is_print_last_receipt"/>
                        </div>
                    </div>
                </setting>
                <div class="content-group mt16" invisible="1">
                    <field name="design_receipt"/>
                    <field name="last_design_receipt"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
